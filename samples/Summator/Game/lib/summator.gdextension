[configuration]

entry_symbol = "summator_library_init"
compatibility_minimum = 4.1

[libraries]

linux.x86_64.debug = "res://lib/Summator.so"
;linux.x86_64.release = "res://lib/Summator.so"
;linux.debug.arm64 = "res://lib/Summator.so"
;linux.release.arm64 = "res://lib/Summator.so"
;windows.x86_64.debug = "res://lib/Summator.dll"
;windows.x86_64.release = "res://lib/Summator.dll"
macos.debug = "res://lib/macos/Summator.dylib"
macos.release = "res://lib/macos/Summator.dylib"
android.debug.arm64 = "res://lib/android/arm64/libSummator.so"
android.release.arm64 = "res://lib/android/arm64/libSummator.so"
android.debug.arm32 = "res://lib/android/armv7/libSummator.so"
android.release.arm32 = "res://lib/android/armv7/libSummator.so"
android.debug.armv7 = "res://lib/android/armv7/libSummator.so"
android.release.armv7 = "res://lib/android/armv7/libSummator.so"
ios.release.arm64 = "res://lib/ios/Summator.framework"
ios.debug.arm64 = "res://lib/ios/Summator.framework"